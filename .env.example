# Copy to .env and replace every CHANGE_ME value. Never use these values in production.
COMPOSE_PROJECT_NAME=car_refactor

MYSQL_HOST_PORT=3306
MYSQL_DATABASE=car_system
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_USER=car_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP

REDIS_HOST_PORT=6379
REDIS_USER=car_app
REDIS_PASSWORD=CHANGE_ME_REDIS_APP

AMQPS_HOST_PORT=5671
MQTTS_HOST_PORT=8883
RABBITMQ_HTTPS_HOST_PORT=15671
RABBITMQ_USER=car_app
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_APP
RABBITMQ_ERLANG_COOKIE=CHANGE_ME_RABBITMQ_COOKIE
