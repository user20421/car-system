{
    "swagger": "2.0",
    "info": {
        "description": "车联网系统后端接口文档：鉴权 / 车辆遥测 / 实时推送",
        "title": "Car System 车联网后端 API",
        "contact": {
            "name": "user20421"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "鉴权"
                ],
                "summary": "用户登录",
                "parameters": [
                    {
                        "description": "登录信息",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.AuthRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "登录成功，data.token 为 JWT",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "参数不合法",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "用户名或密码错误",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "鉴权"
                ],
                "summary": "用户注册",
                "parameters": [
                    {
                        "description": "注册信息",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.AuthRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "注册成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "参数不合法",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "409": {
                        "description": "用户名已存在",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/profile": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "鉴权"
                ],
                "summary": "当前用户信息",
                "responses": {
                    "200": {
                        "description": "data 为 JWT Claims",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "未认证",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/simulator/start": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "模拟器"
                ],
                "summary": "启动虚拟车队",
                "parameters": [
                    {
                        "description": "模拟参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/backend-go_internal_simulator.Params"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "已启动",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/simulator/status": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "模拟器"
                ],
                "summary": "虚拟车队状态",
                "responses": {
                    "200": {
                        "description": "running + params",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/simulator/stop": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "模拟器"
                ],
                "summary": "停止虚拟车队",
                "responses": {
                    "200": {
                        "description": "已停止",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/system/metrics": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "系统"
                ],
                "summary": "后端实时性能指标",
                "responses": {
                    "200": {
                        "description": "goroutines/内存/连接池/消息计数/队列深度",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/vehicle": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "车辆"
                ],
                "summary": "车辆列表",
                "responses": {
                    "200": {
                        "description": "data 为车辆数组",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "403": {
                        "description": "权限不足",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/vehicle/telemetry": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "车辆"
                ],
                "summary": "车机上报车况",
                "parameters": [
                    {
                        "description": "车况数据",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.TelemetryRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "上报成功",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "参数不合法",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "车辆不存在",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/vehicle/{vin}/command": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "控车"
                ],
                "summary": "远程控车",
                "parameters": [
                    {
                        "type": "string",
                        "description": "车架号",
                        "name": "vin",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "指令: lock/unlock/ac_on/ac_off/honk",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.CommandRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "指令已下发",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/vehicle/{vin}/command/{id}/ack": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "控车"
                ],
                "summary": "指令执行回执",
                "parameters": [
                    {
                        "type": "string",
                        "description": "车架号",
                        "name": "vin",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "指令ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "回执: executed/failed",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler.AckRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "回执已记录",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/vehicle/{vin}/commands": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "控车"
                ],
                "summary": "指令历史",
                "parameters": [
                    {
                        "type": "string",
                        "description": "车架号",
                        "name": "vin",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "条数(默认20)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "指令列表",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/vehicle/{vin}/telemetry/latest": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "车辆"
                ],
                "summary": "查询最新车况",
                "parameters": [
                    {
                        "type": "string",
                        "description": "车架号 (17位)",
                        "name": "vin",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "data 为最新车况",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "车辆或数据不存在",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "系统"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "全部组件正常",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "503": {
                        "description": "有组件异常",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "backend-go_internal_simulator.Params": {
            "type": "object",
            "properties": {
                "fault_rate": {
                    "description": "0 ~ 0.1，每帧触发故障的概率",
                    "type": "number"
                },
                "interval_ms": {
                    "description": "100 ~ 5000",
                    "type": "integer"
                },
                "vehicle_count": {
                    "description": "1 ~ 50",
                    "type": "integer"
                }
            }
        },
        "internal_handler.AckRequest": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "executed",
                        "failed"
                    ]
                }
            }
        },
        "internal_handler.AuthRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "minLength": 6
                },
                "username": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 3
                }
            }
        },
        "internal_handler.CommandRequest": {
            "type": "object",
            "required": [
                "command"
            ],
            "properties": {
                "command": {
                    "type": "string",
                    "enum": [
                        "lock",
                        "unlock",
                        "ac_on",
                        "ac_off",
                        "honk"
                    ]
                }
            }
        },
        "internal_handler.TelemetryRequest": {
            "type": "object",
            "required": [
                "vin"
            ],
            "properties": {
                "battery": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0
                },
                "fault_code": {
                    "type": "string"
                },
                "lat": {
                    "type": "number",
                    "maximum": 90,
                    "minimum": -90
                },
                "lng": {
                    "type": "number",
                    "maximum": 180,
                    "minimum": -180
                },
                "rpm": {
                    "type": "integer",
                    "minimum": 0
                },
                "speed": {
                    "type": "number",
                    "minimum": 0
                },
                "vin": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "格式: Bearer \u003ctoken\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}