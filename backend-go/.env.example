# Development example only. Keep passwords aligned with the root Compose environment.
APP_ENV=development
LOG_LEVEL=info
HTTPS_ADDR=:8443
MQTTS_ADDR=:8883
PUBLIC_URL=https://localhost:8443
TLS_DIR=../deploy/certs
CA_CERT_FILE=../deploy/certs/ca.crt
HTTPS_CERT_FILE=../deploy/certs/https-server.crt
HTTPS_KEY_FILE=../deploy/certs/https-server.key
MQTTS_CERT_FILE=../deploy/certs/mqtt-server.crt
MQTTS_KEY_FILE=../deploy/certs/mqtt-server.key
# Created automatically in development with mode 0600; provision it explicitly in production.
JWT_PRIVATE_KEY_FILE=.secrets/jwt-es256.key

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=car_system
MYSQL_USER=car_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP

REDIS_ADDR=localhost:6379
REDIS_USER=car_app
REDIS_PASSWORD=CHANGE_ME_REDIS_APP

RABBITMQ_HOST=localhost:5671
RABBITMQ_USER=car_app
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_APP
# Alternatively provide a complete amqps://user:password@host:5671/car URL.
# RABBITMQ_URL=amqps://car_app:CHANGE_ME_RABBITMQ_APP@localhost:5671/car

TELEMETRY_WORKERS=4
TELEMETRY_QUEUE=4096
TELEMETRY_BATCH_SIZE=200
