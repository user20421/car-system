# ============================================================
# car-system 统一忽略规则
# 覆盖: Vue/Node | Flutter/Dart | Qt/C++ | Go | IDE | OS | Docker
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- 编辑器 / IDE ----------
.idea/
*.iml
*.suo
*.user
*.swp
*.swo
*~

# VS Code（保留共享配置，忽略个人配置）
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---------- Vue / Node.js (admin-dashboard) ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# 环境变量与日志（如需入库请用 .env.example）
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 包管理器缓存/锁文件冲突产物（保留 package-lock.json）
.pnpm-store/

# ---------- Flutter / Dart (flutter_application) ----------
# Dart/Flutter 工具与包缓存
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# Flutter 版本元数据与临时文件
.metadata
*.lock
!/pubspec.lock
.flutter-plugins*
**/doc/api/

