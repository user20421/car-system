debug/
release/
*.Debug
*.Release
Makefile.Debug
Makefile.Release
object_script.*

# ---------- Go (backend-go) ----------
# 编译出的二进制（以项目名/常见名为准）
/backend-go/*.exe
/backend-go/*.exe~
/backend-go/car-system
/backend-go/backend-go
*.test
*.out
/vendor/

# Go 工作区文件（按需保留）
go.work
go.work.sum

# ---------- Docker / 数据库 / 中间件数据 ----------
# 防止本地数据库卷、日志被误提交
data/
mysql-data/
redis-data/
rabbitmq-data/
*.pid
*.seed

